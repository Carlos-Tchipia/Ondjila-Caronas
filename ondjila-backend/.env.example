# Base de dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ondjila
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=2592000

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=./uploads/

# Email (para OTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@Ondjila.ao
MAIL_PASS=

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:4200

# App
APP_ENV=development
APP_DEBUG=true
APP_COMMISSION=0.15
POOL_MATCH_TIMEOUT=300
POOL_MAX_PASSENGERS=4
